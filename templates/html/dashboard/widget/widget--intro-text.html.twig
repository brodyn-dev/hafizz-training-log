{% autoescape false %}
    {% set numberTagOpen = '<span class="font-heading font-semibold tabular-nums text-primary">' %}
    {% set numberTagClose = '</span>' %}
    <p class="mb-3">
        {% set numberOfDaysAgo = numberTagOpen ~ intro.getTotalDaysSinceFirstActivity() ~ numberTagClose %}
        {% set startDate = '<span class="text-sm">' ~ intro.getStartDate()|formatDate('normal') ~ '</span>' %}
        {% set totalDaysOfWorkingOut = numberTagOpen ~ intro.getTotalDaysOfWorkingOut() ~ numberTagClose %}
        {% trans with {'{numberOfDaysAgo}': numberOfDaysAgo, '{startDate}': startDate, '{totalDaysOfWorkingOut}': totalDaysOfWorkingOut} %}
            I started training {numberOfDaysAgo} ago, on {startDate}. Since then I've logged {totalDaysOfWorkingOut} active days.
        {% endtrans %}
    </p>
    <p class="mb-3">
        {% set convertedIntroDistance = intro.getDistance()|convertMeasurement %}
        {% set convertedIntroElevation = intro.getElevation()|convertMeasurement %}
        {% set totalDistance = numberTagOpen ~ convertedIntroDistance.toFloat()|formatNumber(0) ~ ' ' ~ convertedIntroDistance.getSymbol() ~ numberTagClose %}
        {% set numberOfTripsAroundTheWorld = numberTagOpen ~ (intro.getDistance().toFloat() / 40075)|formatNumber(2) ~ numberTagClose %}
        {% set numberOfTripsToTheMoonPercent = numberTagOpen ~ (intro.getDistance().toFloat() / 384400 * 100)|formatNumber(1) ~ numberTagClose %}
        {% set totalElevation = numberTagOpen ~ convertedIntroElevation.toFloat()|formatNumber(0) ~ ' ' ~ convertedIntroElevation.getSymbol() ~ numberTagClose %}
        {% set timesMountEverest = numberTagOpen ~ (intro.getElevation().toFloat() / 8849)|formatNumber(1) ~ numberTagClose %}
        {% set totalTimeRecorded = numberTagOpen ~ intro.getMovingTimeFormatted() ~ numberTagClose %}
        {% trans with {
            '{totalDistance}': totalDistance,
            '{numberOfTripsAroundTheWorld}': numberOfTripsAroundTheWorld,
            '{numberOfTripsToTheMoonPercent}': numberOfTripsToTheMoonPercent,
            '{totalElevation}': totalElevation,
            '{timesMountEverest}': timesMountEverest,
            '{totalTimeRecorded}': totalTimeRecorded
        } %}
            I've covered {totalDistance} in that time, which is {numberOfTripsAroundTheWorld} trips around the world 🌍 or {numberOfTripsToTheMoonPercent}% of the way to the moon 🌕. I've also climbed {totalElevation} in elevation, {timesMountEverest} times Mount Everest 🏔. All of it adds up to {totalTimeRecorded} of moving time.
        {% endtrans %}
    </p>
    <p class="mb-3">
        {% set convertedDailyAverage = intro.getDailyAverage()|convertMeasurement %}
        {% set convertedWeeklyAverage = intro.getWeeklyAverage()|convertMeasurement %}
        {% set convertedMonthlyAverage = intro.getMonthlyAverage()|convertMeasurement %}
        {% set dailyAverage = numberTagOpen ~ convertedDailyAverage.toFloat()|formatNumber(0) ~ ' ' ~ convertedDailyAverage.getSymbol() ~ numberTagClose %}
        {% set weeklyAverage = numberTagOpen ~ convertedWeeklyAverage.toFloat()|formatNumber(0) ~ ' ' ~ convertedWeeklyAverage.getSymbol() ~ numberTagClose %}
        {% set monthlyAverage = numberTagOpen ~ convertedMonthlyAverage.toFloat()|formatNumber(0) ~ ' ' ~ convertedMonthlyAverage.getSymbol() ~ numberTagClose %}
        {% trans with {'{dailyAverage}': dailyAverage, '{weeklyAverage}': weeklyAverage, '{monthlyAverage}': monthlyAverage} %}
            On average that's {dailyAverage} a day, {weeklyAverage} a week, and {monthlyAverage} a month.
        {% endtrans %}
    </p>
    <p>
        {% set caloriesBurned = numberTagOpen ~ intro.getCalories()|formatNumber(0) ~ numberTagClose %}
        {% set numberOfPizzaSlices = numberTagOpen ~ (intro.getCalories() / 270)|formatNumber(0) ~ numberTagClose %}
        {% trans with {'{caloriesBurned}': caloriesBurned, '{numberOfPizzaSlices}': numberOfPizzaSlices} %}
            All that burned an estimated {caloriesBurned} calories — about {numberOfPizzaSlices} slices of pizza 🍕.
        {% endtrans %}
    </p>
{% endautoescape %}
